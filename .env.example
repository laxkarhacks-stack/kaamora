# Kaamora Environment Variables
# Copy to .env.local for local development
# NEVER commit real secrets

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kaamora

# Supabase (Auth + PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub (app source sync) — server only
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Telegram (async notifications) — server only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payment gateway (abstraction) — server only
PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
SESSION_SECRET=
IDLE_SESSION_TIMEOUT_MINUTES=60

# Trial defaults
ANONYMOUS_TRIAL_ALLOWANCE=1
ACCOUNT_TRIAL_BONUS_CREDITS=0

# Feature flags
ENABLE_GITHUB_SYNC=false
ENABLE_TELEGRAM=false
ENABLE_PAYMENTS=false
